<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../windows-dotnet/Interop/SettingsStore.cs" Link="Interop/SettingsStore.cs" />
    <Compile Include="../windows-dotnet/Interop/SessionConnection.cs" Link="Interop/SessionConnection.cs" />
    <Compile Include="../windows-dotnet/Interop/SignInFlow.cs" Link="Interop/SignInFlow.cs" />
    <Compile Include="../windows-dotnet/Interop/WindowsNotifications.cs" Link="Interop/WindowsNotifications.cs" />
    <Compile Include="../windows-dotnet/Interop/TrustStore.cs" Link="Interop/TrustStore.cs" />
    <Compile Include="../windows-dotnet/Interop/WindowsHello.cs" Link="Interop/WindowsHello.cs" />
    <Compile Include="../windows-dotnet/Interop/RustNative.cs" Link="Interop/RustNative.cs" />
    <Compile Include="../windows-dotnet/Interop/DeviceKey.cs" Link="Interop/DeviceKey.cs" />
    <Compile Include="../windows-dotnet/Interop/DeploymentStore.cs" Link="Interop/DeploymentStore.cs" />
    <Compile Include="../windows-dotnet/Interop/SessionListing.cs" Link="Interop/SessionListing.cs" />
    <Compile Include="../windows-dotnet/Interop/SshKeys.cs" Link="Interop/SshKeys.cs" />
    <Compile Include="../windows-dotnet/Interop/MachineMutation.cs" Link="Interop/MachineMutation.cs" />
    <Compile Include="../windows-dotnet/Interop/ExternalActivation.cs" Link="Interop/ExternalActivation.cs" />
    <Compile Include="../windows-dotnet/Interop/WebEndpoint.cs" Link="Interop/WebEndpoint.cs" />
    <Compile Include="../windows-dotnet/Interop/WebOrigin.cs" Link="Interop/WebOrigin.cs" />
    <Compile Include="../windows-dotnet/Interop/TerminalSession.cs" Link="Interop/TerminalSession.cs" />
  </ItemGroup>
  <Target Name="StageMilaNative" AfterTargets="Build">
    <Error Condition="'$(MilaNativeDll)' == '' Or !Exists('$(MilaNativeDll)')" Text="Supply MilaNativeDll pointing to the staged production mila_native.dll." />
    <Copy SourceFiles="$(MilaNativeDll)" DestinationFiles="$(TargetDir)mila_native.dll" />
  </Target>
</Project>
