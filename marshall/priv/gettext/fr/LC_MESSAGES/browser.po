#, elixir-autogen, elixir-format
msgid "%{count}d ago"
msgstr "il y a %{count} j"

#: lib/marshall_web/browser_messages.ex:18
#, elixir-autogen, elixir-format
msgid "%{count}h ago"
msgstr "il y a %{count} h"

#: lib/marshall_web/browser_messages.ex:19
#, elixir-autogen, elixir-format
msgid "%{count}m ago"
msgstr "il y a %{count} min"

#: lib/marshall_web/browser_messages.ex:20
#, elixir-autogen, elixir-format
msgid "%{label} copied."
msgstr "%{label} copié."

#: lib/marshall_web/browser_messages.ex:10
#, elixir-autogen, elixir-format
msgid "%{name} · %{count} viewing"
msgstr "%{name} · %{count} personnes regardent"

#: lib/marshall_web/browser_messages.ex:12
#, elixir-autogen, elixir-format
msgid "%{name} · %{count} viewing · %{activity}"
msgstr "%{name} · %{count} personnes regardent · %{activity}"

#: lib/marshall_web/browser_messages.ex:8
#, elixir-autogen, elixir-format
msgid "%{name} · Terminals"
msgstr "%{name} · Terminaux"

#: lib/marshall_web/browser_messages.ex:21
#, elixir-autogen, elixir-format
msgid "+ New"
msgstr "+ Nouveau"

#: lib/marshall_web/browser_messages.ex:22
#, elixir-autogen, elixir-format
msgid "Applying administrative change…"
msgstr "Application de la modification administrative…"

#: lib/marshall_web/browser_messages.ex:23
#, elixir-autogen, elixir-format
msgid "Boot log · read-only"
msgstr "Journal de démarrage · lecture seule"

#: lib/marshall_web/browser_messages.ex:24
#, elixir-autogen, elixir-format
msgid "Close this terminal session?"
msgstr "Fermer cette session de terminal ?"

#: lib/marshall_web/browser_messages.ex:25
#, elixir-autogen, elixir-format
msgid "Command"
msgstr "Commande"

#: lib/marshall_web/browser_messages.ex:27
#, elixir-autogen, elixir-format
msgid "Could not copy. Select the text and copy it manually."
msgstr ""
"Impossible de copier. Sélectionnez le texte et copiez-le manuellement."

#: lib/marshall_web/browser_messages.ex:29
#, elixir-autogen, elixir-format
msgid "Could not update access. Check the account's machine access."
msgstr ""
"Impossible de modifier l’accès. Vérifiez l’accès du compte à la machine."

#: lib/marshall_web/browser_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Enter full screen"
msgstr "Passer en plein écran"

#: lib/marshall_web/browser_messages.ex:31
#, elixir-autogen, elixir-format
msgid "Exit full screen"
msgstr "Quitter le plein écran"

#: lib/marshall_web/browser_messages.ex:33
#, elixir-autogen, elixir-format
msgid "Input buffer full — that input was not sent"
msgstr "Tampon de saisie plein — cette saisie n’a pas été envoyée"

#: lib/marshall_web/browser_messages.ex:40
#, elixir-autogen, elixir-format
msgid "Match found"
msgstr "Correspondance trouvée"

#: lib/marshall_web/browser_messages.ex:41
#, elixir-autogen, elixir-format
msgid "No matches"
msgstr "Aucune correspondance"

#: lib/marshall_web/browser_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Open this link?\n\n%{url}"
msgstr ""
"Ouvrir ce lien ?\n"
"\n"
"%{url}"

#: lib/marshall_web/browser_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Opening…"
msgstr "Ouverture…"

#: lib/marshall_web/browser_messages.ex:46
#, elixir-autogen, elixir-format
msgid "Passkey request cancelled. You can try again."
msgstr "Demande de clé d’accès annulée. Vous pouvez réessayer."

#: lib/marshall_web/browser_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Passkey verification failed or unavailable. Try again."
msgstr "Vérification de clé d’accès échouée ou indisponible. Réessayez."

#: lib/marshall_web/browser_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Terminal name (this browser only; empty restores the generated name)"
msgstr ""
"Nom du terminal (dans ce navigateur uniquement ; vide rétablit le nom "
"généré)"

#: lib/marshall_web/browser_messages.ex:55
#, elixir-autogen, elixir-format
msgid "The result could not be confirmed. Reload the page and check the result before retrying."
msgstr ""
"Le résultat n’a pas pu être confirmé. Rechargez la page et vérifiez le "
"résultat avant de réessayer."

#: lib/marshall_web/browser_messages.ex:60
#, elixir-autogen, elixir-format
msgid "This machine asks to write %{bytes} bytes to your clipboard. Type once, session, or mute."
msgstr ""
"Cette machine demande d’écrire %{bytes} octets dans votre presse-papiers. "
"Tapez once, session ou mute."

#: lib/marshall_web/browser_messages.ex:66
#, elixir-autogen, elixir-format
msgid "This repository link could not be launched. Open the link again."
msgstr "Ce lien de dépôt n’a pas pu être lancé. Ouvrez à nouveau le lien."

#: lib/marshall_web/browser_messages.ex:70
#, elixir-autogen, elixir-format
msgid "Type to interact"
msgstr "Tapez pour interagir"

#: lib/marshall_web/browser_messages.ex:71
#, elixir-autogen, elixir-format
msgid "Updating viewing access…"
msgstr "Modification du droit de consultation…"

#: lib/marshall_web/browser_messages.ex:73
#, elixir-autogen, elixir-format
msgid "Verification could not be completed. Try again."
msgstr "La vérification n’a pas pu être effectuée. Réessayez."

#: lib/marshall_web/browser_messages.ex:75
#, elixir-autogen, elixir-format
msgid "Verify with your passkey to %{action}. This runs once after verification."
msgstr ""
"Vérifiez avec votre clé d’accès pour %{action}. Cette opération s’exécute "
"une fois après vérification."

#: lib/marshall_web/browser_messages.ex:80
#, elixir-autogen, elixir-format
msgid "View only"
msgstr "Consultation uniquement"

#: lib/marshall_web/browser_messages.ex:81
#, elixir-autogen, elixir-format
msgid "Viewing access updated."
msgstr "Droit de consultation modifié."

#: lib/marshall_web/browser_messages.ex:82
#, elixir-autogen, elixir-format
msgid "Waiting for your passkey…"
msgstr "En attente de votre clé d’accès…"

#: lib/marshall_web/browser_messages.ex:84
#, elixir-autogen, elixir-format
msgid "complete this administrative change"
msgstr "effectuer cette modification administrative"

#: lib/marshall_web/browser_messages.ex:85
#, elixir-autogen, elixir-format
msgid "just now"
msgstr "à l’instant"

#: lib/marshall_web/browser_messages.ex:86
#, elixir-autogen, elixir-format
msgid "● live"
msgstr "● en direct"

#: lib/marshall_web/browser_messages.ex:87
#, elixir-autogen, elixir-format
msgid "● read-only"
msgstr "● lecture seule"

#: lib/marshall_web/browser_messages.ex:88
#, elixir-autogen, elixir-format
msgid "⟳ reconnecting…"
msgstr "⟳ reconnexion…"

#: lib/marshall_web/browser_messages.ex:89
#, elixir-autogen, elixir-format
msgid "⟳ restoring scrollback…"
msgstr "⟳ restauration de l’historique du terminal…"

#: lib/marshall_web/browser_messages.ex:36
#, elixir-autogen, elixir-format
msgid "Connecting…"
msgstr "Connexion en cours…"

#: lib/marshall_web/browser_messages.ex:39
#, elixir-autogen, elixir-format
msgid "Diagram unavailable. Source:\n%{source}"
msgstr "Diagramme indisponible. Source :\n%{source}"

#: lib/marshall_web/browser_messages.ex:37
#, elixir-autogen, elixir-format
msgid "No terminals"
msgstr "Aucun terminal"

#: lib/marshall_web/browser_messages.ex:35
#, elixir-autogen, elixir-format
msgid "— output before this view is not in the scrollback window —"
msgstr "— la sortie précédant cette vue ne figure pas dans l’historique de défilement —"

#: lib/marshall_web/browser_messages.ex:67
#, elixir-autogen, elixir-format
msgid "Terminal input"
msgstr "Saisie du terminal"

#: lib/marshall_web/browser_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Too much output to announce, navigate to rows manually to read"
msgstr "La sortie est trop volumineuse pour être annoncée ; parcourez les lignes manuellement pour la lire"
