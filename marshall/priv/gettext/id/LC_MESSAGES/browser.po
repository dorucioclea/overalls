#, elixir-autogen, elixir-format
msgid "Exit full screen"
msgstr "Keluar layar penuh"

#: lib/marshall_web/browser_messages.ex:33
#, elixir-autogen, elixir-format
msgid "Input buffer full — that input was not sent"
msgstr "Buffer input penuh — input tidak dikirim"

#: lib/marshall_web/browser_messages.ex:40
#, elixir-autogen, elixir-format
msgid "Match found"
msgstr "Kecocokan ditemukan"

#: lib/marshall_web/browser_messages.ex:41
#, elixir-autogen, elixir-format
msgid "No matches"
msgstr "Tidak ada kecocokan"

#: lib/marshall_web/browser_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Open this link?\n\n%{url}"
msgstr "Buka tautan ini?\n\n%{url}"

#: lib/marshall_web/browser_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Opening…"
msgstr "Membuka…"

#: lib/marshall_web/browser_messages.ex:46
#, elixir-autogen, elixir-format
msgid "Passkey request cancelled. You can try again."
msgstr "Permintaan passkey dibatalkan. Anda dapat mencoba lagi."

#: lib/marshall_web/browser_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Passkey verification failed or unavailable. Try again."
msgstr "Verifikasi passkey gagal atau tidak tersedia. Coba lagi."

#: lib/marshall_web/browser_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Terminal name (this browser only; empty restores the generated name)"
msgstr "Nama terminal (hanya browser ini; kosongkan untuk memulihkan nama yang dibuat)"

#: lib/marshall_web/browser_messages.ex:55
#, elixir-autogen, elixir-format
msgid "The result could not be confirmed. Reload the page and check the result before retrying."
msgstr "Hasil tidak dapat dikonfirmasi. Muat ulang halaman dan periksa hasilnya sebelum mencoba lagi."

#: lib/marshall_web/browser_messages.ex:60
#, elixir-autogen, elixir-format
msgid "This machine asks to write %{bytes} bytes to your clipboard. Type once, session, or mute."
msgstr "Mesin ini meminta menulis %{bytes} byte ke papan klip Anda. Ketik sekali, sesi, atau bisukan."

#: lib/marshall_web/browser_messages.ex:66
#, elixir-autogen, elixir-format
msgid "This repository link could not be launched. Open the link again."
msgstr "Tautan repositori ini tidak dapat dibuka. Buka tautan lagi."

#: lib/marshall_web/browser_messages.ex:70
#, elixir-autogen, elixir-format
msgid "Type to interact"
msgstr "Ketik untuk berinteraksi"

#: lib/marshall_web/browser_messages.ex:71
#, elixir-autogen, elixir-format
msgid "Updating viewing access…"
msgstr "Memperbarui akses tampilan…"

#: lib/marshall_web/browser_messages.ex:73
#, elixir-autogen, elixir-format
msgid "Verification could not be completed. Try again."
msgstr "Verifikasi tidak dapat diselesaikan. Coba lagi."

#: lib/marshall_web/browser_messages.ex:75
#, elixir-autogen, elixir-format
msgid "Verify with your passkey to %{action}. This runs once after verification."
msgstr "Verifikasi dengan passkey Anda untuk %{action}. Ini berjalan sekali setelah verifikasi."

