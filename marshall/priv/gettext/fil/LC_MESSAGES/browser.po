msgstr "Pangalan ng terminal (ang browser na ito lamang; ibinabalik ng walang laman ang nabuong pangalan)"

#: lib/marshall_web/browser_messages.ex:55
#, elixir-autogen, elixir-format
msgid "The result could not be confirmed. Reload the page and check the result before retrying."
msgstr "Hindi makumpirma ang resulta. I-reload ang page at tingnan ang resulta bago subukang muli."

#: lib/marshall_web/browser_messages.ex:60
#, elixir-autogen, elixir-format
msgid "This machine asks to write %{bytes} bytes to your clipboard. Type once, session, or mute."
msgstr "Hinihiling ng makinang ito na isulat ang %{bytes} byte sa iyong clipboard. Mag-type nang isang beses, session, o i-mute."

#: lib/marshall_web/browser_messages.ex:66
#, elixir-autogen, elixir-format
msgid "This repository link could not be launched. Open the link again."
msgstr "Hindi mailunsad ang link ng repositoryong ito. Buksan muli ang link."

